<%--
    Name:        Garvin Stewart
    Date:        October 25, 2026
    Assignment:  CSD 430 Module 1 - Installation & Configuration (First JSP)

    Purpose:     Verify that Java, Tomcat, and the IDE work together by rendering
                 an HTML page whose content is generated by embedded Java code.

    Source note: Drafted with help from Claude (Anthropic AI), then reviewed,
                 run, and verified by Garvin Stewart on his own environment.
--%>
<%-- trimDirectiveWhitespaces keeps <!DOCTYPE html> as the first line of output --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"
         trimDirectiveWhitespaces="true" %>
<%@ page import="java.time.LocalDateTime" %>
<%@ page import="java.time.format.DateTimeFormatter" %>

<%!
    // JSP declaration: a helper method compiled into the generated servlet class.
    // Returns a plain-English status label for a given course week.
    private String describeWeek(int weekNumber, int totalWeeks) {
        if (weekNumber == 1) {
            return "Installation & Configuration (this week)";
        } else if (weekNumber == totalWeeks) {
            return "Final week";
        }
        return "Upcoming";
    }
%>

<%
    // Scriptlet: gather runtime facts that prove which Java and Tomcat versions served this page.
    String javaVersion = System.getProperty("java.version");
    String javaVendor  = System.getProperty("java.vendor");
    String serverInfo  = application.getServerInfo();
    String servletSpec = application.getMajorVersion() + "." + application.getMinorVersion();
    String jspSpec     = JspFactory.getDefaultFactory().getEngineInfo().getSpecificationVersion();

    // Timestamp of the request, formatted for display.
    DateTimeFormatter displayFormat = DateTimeFormatter.ofPattern("MMMM d, yyyy h:mm:ss a");
    String requestTime = LocalDateTime.now().format(displayFormat);

    // Course length used by the loop that builds the schedule table below.
    int totalCourseWeeks = 9;
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CSD 430 Module 1 - First JSP</title>
    <style>
        body  { font-family: Arial, sans-serif; margin: 2rem; color: #222; }
        table { border-collapse: collapse; margin-top: 1rem; }
        th, td { border: 1px solid #999; padding: 6px 12px; text-align: left; }
        th    { background-color: #e8e8e8; }
        .ok   { color: #1a7f37; font-weight: bold; }
    </style>
</head>
<body>

    <h1>CSD 430 Module 1: First JSP</h1>
    <p class="ok">This page was generated by Java code running inside Tomcat.</p>

    <!-- Environment section: values come from the scriptlet above via JSP expressions -->
    <h2>Runtime Environment</h2>
    <table>
        <tr><th>Item</th><th>Value</th></tr>
        <tr><td>Java version</td><td><%= javaVersion %></td></tr>
        <tr><td>Java vendor</td><td><%= javaVendor %></td></tr>
        <tr><td>Server</td><td><%= serverInfo %></td></tr>
        <tr><td>Servlet specification</td><td><%= servletSpec %></td></tr>
        <tr><td>JSP specification</td><td><%= jspSpec %></td></tr>
        <tr><td>Request time</td><td><%= requestTime %></td></tr>
    </table>

    <!-- Schedule section: a Java for-loop writes one HTML table row per course week -->
    <h2>Course Weeks</h2>
    <table>
        <tr><th>Week</th><th>Status</th></tr>
        <% for (int week = 1; week <= totalCourseWeeks; week++) { %>
            <tr>
                <td><%= week %></td>
                <td><%= describeWeek(week, totalCourseWeeks) %></td>
            </tr>
        <% } %>
    </table>

</body>
</html>
